# 仅供 Docker Compose 插值，不是应用配置文件，不要在此存放管理/API/GitHub 密钥。
# 可复制为 .env（已被 .gitignore 排除）。更改后 docker compose up -d 重新创建容器。

# 稳定最新版；生产环境推荐固定具体版本（例如 :1.2.3）或 @sha256:...。
# 自己 fork 发布后，改为自己的 GHCR owner/repository，必须小写。
COPILOT_IMAGE=ghcr.io/1oo1/cpa-github-copilot:latest

# 持久化数据目录。相对路径以 compose.yaml 所在目录为基准。
# 必须事先创建，内含可写的 config.yaml；保留整个目录用于升级与恢复。
COPILOT_DATA_DIR=./data

# 必须与数据目录所有者匹配。Linux 普通用户建议用 id -u / id -g 的结果替换。
# 默认镜像用户为 10001:10001；不要为了省事改为 0:0 或 chmod 777。
COPILOT_UID=10001
COPILOT_GID=10001

# 宿主机监听地址与端口，不改变容器内的 0.0.0.0:8317。
# 使用公网 0.0.0.0 前请配置 HTTPS 反向代理及防火墙。
COPILOT_BIND_ADDRESS=127.0.0.1
COPILOT_PORT=8317

# 容器资源上限，账户多/并发高时可增大。内存不足可能导致 OOM 重启。
COPILOT_MEMORY_LIMIT=512m
COPILOT_CPUS=1.0

# 日志所用时区；面板中的重置时间仍以浏览器本地时区显示。
TZ=UTC
